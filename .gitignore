# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.tiles-build/
scripts/scratch-apply.mjs

# Superpowers brainstorm companion artifacts
.superpowers/

# Python bytecode from the wine-map extraction scripts.
__pycache__/
*.pyc

# A local check of a draft (never promoted) wine-map tiles release writes its
# manifest here (NEXT_PUBLIC_WINE_MAP_MANIFEST_URL=/wine-map-draft/manifest.json).
/public/wine-map-draft/
